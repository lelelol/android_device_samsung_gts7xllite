From 2377238e95d5d96c0b3ff3844c9da88751ca797a Mon Sep 17 00:00:00 2001
From: Leandro <academy@mindsofthefuture.com.br>
Date: Wed, 21 Oct 2026 22:36:48 -0300
Subject: [PATCH] bpfloader: Don't panic on ring buffer files on kernels < 5.8

bpfRingbufProg.bpf is critical on userdebug, but 4.19 has no BPF ring buffers.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Change-Id: Icf3def28eeefa88bf954993197654e5de66edc20
---
 loader/bpfloader.rs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/loader/bpfloader.rs b/loader/bpfloader.rs
index f23d882..9b8e47d 100644
--- a/loader/bpfloader.rs
+++ b/loader/bpfloader.rs
@@ -732,7 +732,8 @@ fn load_libbpf_progs() {
 
     for file_desc in file_vec {
         if let Err(e) = libbpf_worker(&file_desc) {
-            if file_desc.critical {
+            // legacy kernels (< 5.8) have no BPF ring buffers: never fatal there
+            if file_desc.critical && kernel_version().map_or(true, |k| k >= kver(5, 8, 0)) {
                 panic!("Error when loading {0}: {e}", file_desc.filename);
             } else {
                 error!("Error when loading {0}: {e}", file_desc.filename);
-- 
2.53.0

