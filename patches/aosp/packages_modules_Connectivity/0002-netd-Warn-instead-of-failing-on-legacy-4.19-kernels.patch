From fe46390a011fc966500c5abb58797fb55bc9c9ca Mon Sep 17 00:00:00 2001
From: Leandro <academy@mindsofthefuture.com.br>
Date: Thu, 22 Oct 2026 12:27:52 -0300
Subject: [PATCH 2/5] netd: Warn instead of failing on legacy 4.19 kernels

The 25Q2 kernel 5.4 gate only logs now; everything after it in initPrograms()
is already gated on the kernel version.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Change-Id: Ic5c13f397fd6038d9bccc92a1dcf4be6413d0ba6
---
 bpf/netd/BpfHandler.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/bpf/netd/BpfHandler.cpp b/bpf/netd/BpfHandler.cpp
index 9b57548..4df5e07 100644
--- a/bpf/netd/BpfHandler.cpp
+++ b/bpf/netd/BpfHandler.cpp
@@ -134,9 +134,10 @@ static Result<void> initPrograms(const char* cg2_path) {
         return Error() << "V+ platform with kernel version < 4.19.0 is unsupported";
     }
 
-    // 25Q2 bumps the kernel requirement up to 5.4
+    // 25Q2 bumps the kernel requirement up to 5.4; legacy 4.19 devices keep working
+    // since everything below is already gated on the kernel version.
     if (isAtLeast25Q2 && !isAtLeastKernelVersion(5, 4)) {
-        return Error() << "25Q2+ platform with kernel version < 5.4.0 is unsupported";
+        ALOGW("25Q2+ platform with kernel version < 5.4.0 is unsupported, continuing anyway");
     }
 
     unique_fd cg_fd(open(cg2_path, O_DIRECTORY | O_RDONLY | O_CLOEXEC));
-- 
2.53.0

