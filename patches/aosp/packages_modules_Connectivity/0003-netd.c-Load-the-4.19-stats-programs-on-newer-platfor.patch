From 99a7b18793fda9378c418f85f6e2e70bd53fdb9d Mon Sep 17 00:00:00 2001
From: Leandro <academy@mindsofthefuture.com.br>
Date: Thu, 22 Oct 2026 12:27:52 -0300
Subject: [PATCH 3/5] netd.c: Load the 4.19 stats programs on newer platforms

The 4.19 ingress/egress stats variants were capped at 25Q2, so on API 3700 no
variant matched and netd aborted on the missing prog_netd_egress_stats.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Change-Id: Ifbc20422caf2626b15869d67f28dc371c3877175
---
 bpf/progs/netd.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/bpf/progs/netd.c b/bpf/progs/netd.c
index e4cd7c9..d31eeb7 100644
--- a/bpf/progs/netd.c
+++ b/bpf/progs/netd.c
@@ -1019,8 +1019,8 @@ DEFINE_NETD_BPF_PROG_RANGES(ingress, stats, 5_4, INF, T, 25Q4)
     return bpf_traffic_account(skb, INGRESS, KVER_5_4, API(T));
 }
 
-// Android T/U/V 4.19
-DEFINE_NETD_BPF_PROG_RANGES(ingress, stats, 4_19, 5_4, T, 25Q2)
+// Android T/U/V 4.19 (+ newer platforms on legacy 4.19 devices)
+DEFINE_NETD_BPF_PROG_RANGES(ingress, stats, 4_19, 5_4, T, MAXAPI)
 (struct __sk_buff* skb) {
 return bpf_traffic_account(skb, INGRESS, KVER_4_19, API(T));
 }
@@ -1075,8 +1075,8 @@ DEFINE_NETD_BPF_PROG_RANGES(egress, stats, 5_4, INF, T, 25Q4)
     return bpf_traffic_account(skb, EGRESS, KVER_5_4, API(T));
 }
 
-// Android T/U/V 4.19
-DEFINE_NETD_BPF_PROG_RANGES(egress, stats, 4_19, 5_4, T, 25Q2)
+// Android T/U/V 4.19 (+ newer platforms on legacy 4.19 devices)
+DEFINE_NETD_BPF_PROG_RANGES(egress, stats, 4_19, 5_4, T, MAXAPI)
 (struct __sk_buff* skb) {
 return bpf_traffic_account(skb, EGRESS, KVER_4_19, API(T));
 }
