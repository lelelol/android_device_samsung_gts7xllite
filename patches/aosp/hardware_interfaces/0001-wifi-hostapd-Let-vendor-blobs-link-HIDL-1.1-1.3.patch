From 2f7979aed62d5fc24bda3bab2d0e12b92cb72801 Mon Sep 17 00:00:00 2001
From: Leandro <academy@mindsofthefuture.com.br>
Date: Tue, 20 Oct 2026 14:59:34 -0300
Subject: [PATCH 1/2] wifi: hostapd: Let vendor blobs link HIDL 1.1-1.3

Stock Samsung vendor.samsung.hardware.wifi.hostapd@3.0 depends on them; 1.0 already allows //vendor.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Change-Id: I7a56b02e920922df9439835ed71b640b1be3a944
---
 wifi/hostapd/1.1/Android.bp | 2 ++
 wifi/hostapd/1.2/Android.bp | 2 ++
 wifi/hostapd/1.3/Android.bp | 2 ++
 3 files changed, 6 insertions(+)

diff --git a/wifi/hostapd/1.1/Android.bp b/wifi/hostapd/1.1/Android.bp
index b0dbe1f..49cdaaf 100644
--- a/wifi/hostapd/1.1/Android.bp
+++ b/wifi/hostapd/1.1/Android.bp
@@ -35,5 +35,7 @@ hidl_interface {
         "//hardware/interfaces/wifi/hostapd/1.3",
         "//packages/modules/Wifi:__subpackages__",
         "//system/tools/hidl/build",
+        // stock vendor blobs (e.g. Samsung hostapd@3.0)
+        "//vendor:__subpackages__",
     ],
 }
diff --git a/wifi/hostapd/1.2/Android.bp b/wifi/hostapd/1.2/Android.bp
index 64111c0..74d4944 100644
--- a/wifi/hostapd/1.2/Android.bp
+++ b/wifi/hostapd/1.2/Android.bp
@@ -34,5 +34,7 @@ hidl_interface {
         "//hardware/interfaces/wifi/hostapd/1.3",
         "//packages/modules/Wifi:__subpackages__",
         "//system/tools/hidl/build",
+        // stock vendor blobs (e.g. Samsung hostapd@3.0)
+        "//vendor:__subpackages__",
     ],
 }
diff --git a/wifi/hostapd/1.3/Android.bp b/wifi/hostapd/1.3/Android.bp
index 713b4d9..9edeca6 100644
--- a/wifi/hostapd/1.3/Android.bp
+++ b/wifi/hostapd/1.3/Android.bp
@@ -35,5 +35,7 @@ hidl_interface {
         "//hardware/interfaces/wifi/hostapd/aidl/vts/functional",
         "//packages/modules/Wifi:__subpackages__",
         "//system/tools/hidl/build",
+        // stock vendor blobs (e.g. Samsung hostapd@3.0)
+        "//vendor:__subpackages__",
     ],
 }
